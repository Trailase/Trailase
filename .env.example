# Copy to .env.local (git-ignored). Everything below is optional — the app
# runs with none of it set (see src/lib/env.ts for the validated schema).

# --- Contact form email delivery (see src/models/contact/service.ts) -------
# Without these, POST /api/contact returns 503 and the Contact section falls
# back to a mailto link instead of pretending to send anything.

# Resend API key — https://resend.com/api-keys
RESEND_API_KEY=

# Where contact-form submissions are delivered.
CONTACT_TO_EMAIL=

# Optional. Must be a Resend-verified sender; defaults to the shared
# onboarding@resend.dev address (works without domain verification, Resend-branded).
# CONTACT_FROM_EMAIL="Trailase <hello@yourdomain.com>"

# --- App/SEO origin ---------------------------------------------------------
# Public origin used for canonical URLs, OG tags, robots/sitemap, and the
# proxy's connect-src. Defaults to http://localhost:3000. On Railway this is
# derived automatically from RAILWAY_PUBLIC_DOMAIN if left unset.
# NEXT_PUBLIC_APP_URL=http://localhost:3000

# Only set if the API lives on a different origin than the app itself.
# Default-empty means same-origin `/api`.
# NEXT_PUBLIC_API_URL=

# --- Booking link (see contact.tsx) -----------------------------------------
# Public Cal.com/Calendly link. Unset means no calendar link renders, only
# the contact form.
# NEXT_PUBLIC_CAL_LINK=

# --- SEO indexing ------------------------------------------------------------
# Opt-in flag: only "true" makes /robots.txt allow crawling. Leave unset for
# local/preview/staging so they're never indexed.
# SEO_INDEXABLE=
